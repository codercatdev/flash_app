{
  "name": "flashfun-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "tsc -b --noEmit",
    "cf-typegen": "wrangler types",
    "db:generate": "npx @better-auth/cli generate --config worker/auth-cli.ts --output migrations/0002_better_auth.sql -y",
    "db:local": "wrangler d1 migrations apply flashfun --local",
    "db:remote": "wrangler d1 migrations apply flashfun --remote"
  },
  "dependencies": {
    "@better-auth/stripe": "^1.6.30",
    "better-auth": "^1.6.30",
    "hono": "^4.13.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "stripe": "^22.5.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.52.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.0",
    "vite": "^8.2.1",
    "wrangler": "^4.123.0"
  }
}
